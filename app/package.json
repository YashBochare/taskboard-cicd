{
  "name": "taskboard",
  "version": "1.0.0",
  "description": "TaskBoard - sample cloud application delivered through a Jenkins CI/CD pipeline",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "test:ci": "node --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=junit --test-reporter-destination=test-results.xml \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "4.21.2"
  }
}
